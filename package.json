{
  "name": "chargewaze",
  "private": true,
  "version": "0.0.0",
  "description": "ChargeWaze — full-stack EV intelligence and route-planning platform (monorepo root).",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",

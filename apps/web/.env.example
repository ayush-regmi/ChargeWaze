# Chargewise Next.js frontend env template
#
# Copy to apps/web/.env.local (gitignored) for local development. Deployed
# environments inject these via Vercel project settings.
#
# RULE: only NEXT_PUBLIC_* values go here. They are inlined into the client
# bundle. Smartcar secrets, the Mapbox secret token, and Supabase service-role
# keys MUST stay out of this file and out of the browser.

# Backend base URL the browser calls
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase (safe to ship to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OAuth providers: toggle buttons on/off.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=true
# Apple Sign In requires a paid Apple Developer account. Keep this off until
# a Services ID and signing key are configured in Supabase.
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false

# Mapbox public token (required by Mapbox GL JS in the browser). Public-safe.
NEXT_PUBLIC_MAPBOX_PUBLIC_TOKEN=

# Reserved for features built in parallel (docs/plan.md §2.3); each feature
# adds variables only inside its own block.

# Demo mode (Phase 6 F2)

# Observability (Phase 6 F1)
NEXT_PUBLIC_SENTRY_DSN=

# Chargewise FastAPI backend env template
#
# Copy to services/api/.env (gitignored) for local development. Deployed
# environments inject these via the hosting provider's secret store.
#
# RULE: nothing in this file ever reaches the browser. Public / frontend
# values live in apps/web/.env.example instead.

# ----- App -----
APP_ENV=development                 # development | preview | production | test
APP_PUBLIC_DEMO_MODE=false
ALLOWED_ORIGINS=http://localhost:3000

# ----- Database -----
# Supabase gives you a session-pooler Postgres URL in the project dashboard.
# Convert the driver to the SQLAlchemy psycopg form: postgresql+psycopg://...
DATABASE_URL=postgresql+psycopg://chargewise:chargewise@localhost:5432/chargewise

# ----- Supabase Auth -----
SUPABASE_URL=https://your-project.supabase.co
# JWKS endpoint for JWT verification. For a modern Supabase project this is:
#   https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
# Optional. Only used for legacy HS256 projects. Prefer SUPABASE_JWKS_URL.
SUPABASE_JWT_SECRET=
# Only needed for privileged server-side operations (admin APIs). Not required
# for the /me endpoint.
SUPABASE_SERVICE_ROLE_KEY=

# ----- Smartcar V3 (Phase 2) -----
SMARTCAR_CLIENT_ID=
SMARTCAR_CLIENT_SECRET=
# Connect application_id (Dashboard > Configuration). Not the same value as the client ID.
SMARTCAR_APPLICATION_ID=
# Web app route that finishes Connect (must also be allowed in the Smartcar Dashboard).
SMARTCAR_REDIRECT_URI=http://localhost:3000/garage/connect/callback
SMARTCAR_WEBHOOK_ID=
# Application Management Token (Dashboard). HMAC key for SC-Signature and the VERIFY challenge.
SMARTCAR_MANAGEMENT_TOKEN=
SMARTCAR_MODE=live                  # V3 Connect modes: live | simulated (anything else fails at startup)
# Signs the short-lived Connect state JWT. Generate with: openssl rand -hex 32
SMARTCAR_STATE_SECRET=
# Optional overrides; defaults are the production V3 hosts.
# SMARTCAR_API_BASE_URL=https://vehicle.api.smartcar.com/v3
# SMARTCAR_AUTH_URL=https://iam.smartcar.com/oauth2/token
# SMARTCAR_CONNECT_URL=https://connect.smartcar.com/oauth/authorize
SMARTCAR_TIMEOUT_SECONDS=10

# ----- Telemetry -----
TELEMETRY_STALE_AFTER_MINUTES=15
# On-demand "Refresh" limits per vehicle (ADR 0010). Each refresh costs one
# Smartcar vehicle request against the plan's monthly per-vehicle allowance.
SMARTCAR_REFRESH_MIN_INTERVAL_MINUTES=15
SMARTCAR_REFRESH_MAX_PER_DAY=8

# ----- Mapbox server-side token (Phase 3) -----
MAPBOX_SECRET_TOKEN=
# MAPBOX_API_BASE_URL=https://api.mapbox.com
MAPBOX_TIMEOUT_SECONDS=10

# ----- Charging stations (Phase 3) -----
# Free key from https://developer.nlr.gov/signup/ (NREL's API moved from developer.nrel.gov).
AFDC_API_KEY=
# AFDC_API_BASE_URL=https://developer.nlr.gov/api/alt-fuel-stations/v1
STATIONS_TIMEOUT_SECONDS=15
STATIONS_ROUTE_MAX_POINTS=1000

# The blocks below are reserved for features built in parallel (docs/plan.md
# §2.3). Each feature adds variables only inside its own block.

# ----- Stations API + cache (Phase 3 F5) -----
# GET /stations/{id} refreshes a cached station from the provider after this long.
STATIONS_CACHE_TTL_HOURS=24
# HMAC key for GET /stations pagination cursors. Generate one per environment:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty disables paging (next_cursor is always null).
STATIONS_CURSOR_SECRET=

# ----- Energy model (Phase 4 F2) -----

# ----- Trip planner (Phase 4 F4) -----
# Defaults from docs/phase4_plan.md §3 F4 (D4, D11, D16). Leave unset to use them.
# PLANNER_STOP_OVERHEAD_MINUTES=5
# PLANNER_DETOUR_ROAD_FACTOR=1.3
# PLANNER_DETOUR_SPEED_KMH=50
# PLANNER_SOC_GRID_STEP=0.01
# PLANNER_MAX_CORRIDOR_KM=16

# ----- Trips (Phase 4 F1, Phase 5 F3/F4) -----

# ----- Analytics (Phase 5 F5) -----
# ANALYTICS_MAX_BUCKETS=366
# ANALYTICS_EXPORT_MAX_ROWS=10000

# ----- Demo mode (Phase 6 F2) -----

# ----- Privacy and retention (Phase 6 F5) -----
# DELETE /me also deletes the Supabase auth user with SUPABASE_URL +
# SUPABASE_SERVICE_ROLE_KEY (above); without them that step stays owed and
# scripts/retention.py retries it.
# PRIVACY_NOTICE_VERSION=2026-11-19
# Nightly scripts/retention.py windows, in days.
# PRIVACY_UNSAVED_TRIP_DAYS=30
# PRIVACY_TELEMETRY_RETENTION_DAYS=730
# PRIVACY_REFRESH_LOG_DAYS=30
# Keep deletion tombstones longer than the Supabase JWT expiry.
# PRIVACY_TOMBSTONE_DAYS=7
# PRIVACY_REVOCATION_GIVE_UP_DAYS=30

# ----- Weather (Open-Meteo is keyless for non-commercial use) -----
WEATHER_API_KEY=

# ----- Observability -----
# Sentry DSN for the backend project (Sentry > Project Settings > Client Keys).
# Empty disables Sentry; it is always off when APP_ENV=test. Never commit a real DSN.
SENTRY_DSN_BACKEND=
# Optional: Sentry environment tag (defaults to APP_ENV) and trace sampling (0 = errors only).
# SENTRY_ENVIRONMENT=
# SENTRY_TRACES_SAMPLE_RATE=0

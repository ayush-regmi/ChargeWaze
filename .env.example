# Chargewise environment template
#
# Copy this file to `.env` (gitignored) for local development and fill in real values.
# Deployed environments set these via the hosting provider's secret store.
#
# Variable groups:
#   - Backend-only: consumed by FastAPI. NEVER expose these to the browser.
#   - NEXT_PUBLIC_*: inlined into the Next.js client bundle. Only non-secret, public
#     values belong here. Smartcar client secret, webhook secret, and Mapbox secret
#     tokens MUST stay out of this group.

# -----------------------------------------------------------------------------
# Backend-only (FastAPI, services/api)
# -----------------------------------------------------------------------------

# Supabase (server-side verification)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# PostgreSQL (Supabase-hosted or local)
DATABASE_URL=postgresql+psycopg://chargewise:chargewise@localhost:5432/chargewise

# Smartcar V3 (application-level credentials; see docs/adr/0002)
SMARTCAR_CLIENT_ID=replace-me
SMARTCAR_CLIENT_SECRET=replace-me
SMARTCAR_REDIRECT_URI=http://localhost:8000/integrations/smartcar/callback
SMARTCAR_WEBHOOK_ID=replace-me
SMARTCAR_WEBHOOK_SECRET=replace-me
SMARTCAR_MODE=test

# Mapbox server-side token (used by backend-side Directions / Geocoding; never shipped to the browser)
MAPBOX_SECRET_TOKEN=replace-me

# Charging station data (AFDC / NREL)
AFDC_API_KEY=replace-me

# Weather (Open-Meteo is keyless for non-commercial use; leave blank unless a paid provider is configured)
WEATHER_API_KEY=

# Sentry (optional in development)
SENTRY_DSN_BACKEND=

# App config
APP_ENV=development                 # development | preview | production
APP_PUBLIC_DEMO_MODE=false          # true = serve seeded is_simulated=true data only
ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Frontend (Next.js, apps/web). Only public, non-secret values.
# -----------------------------------------------------------------------------

# Backend base URL the browser calls
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase public config (safe to ship to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Mapbox public token (required by Mapbox GL JS in the browser)
NEXT_PUBLIC_MAPBOX_PUBLIC_TOKEN=replace-me

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
